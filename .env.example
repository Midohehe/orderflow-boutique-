# Frontend (Vite) — required for local dev and production build
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Cloudflare Worker deploy (scripts/cf-deploy.ps1) — do not commit real token
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Optional: only needed if you run edge functions locally with `supabase functions serve`
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
